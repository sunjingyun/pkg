{
  "name": "@sunjingyun/pkg",
  "version": "5.12.2",
  "description": "Package your Node.js project into an executable",
  "main": "lib-es5/index.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sunjingyun/pkg.git"
  },
  "types": "lib-es5/index.d.ts",
  "bin": {
    "pkg": "lib-es5/bin.js"
  },
  "files": [
    "lib-es5/*.js",
    "lib-es5/*.d.ts",
    "dictionary/*.js",
    "prelude/*.js"
  ],
  "dependencies": {
    "@babel/generator": "^7.23.0",
    "@babel/parser": "^7.23.0",
    "@babel/traverse": "^7.23.0",
    "@babel/types": "^7.23.0",
    "@roberts_lando/vfs": "^0.3.3",
    "@sunjingyun/pkg-fetch": "3.6.1",
    "esbuild": "^0.28.1",
    "into-stream": "^9.1.0",
    "multistream": "^4.1.0",
    "picocolors": "^1.1.0",
    "picomatch": "^4.0.2",
    "postject": "^1.0.0-alpha.6",
    "prebuild-install": "^7.1.1",
    "resolve": "^1.22.10",
    "resolve.exports": "^2.0.3",
    "stream-meter": "^1.0.4",
    "tar": "^7.5.7",
    "tinyglobby": "^0.2.11",
    "unzipper": "^0.12.3"
  },
  "devDependencies": {
    "@types/babel__generator": "^7.6.5",
    "@types/babel__traverse": "^7.20.3",
    "@types/multistream": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/picomatch": "^3.0.1",
    "@types/resolve": "^1.20.2",
    "@types/stream-meter": "^0.0.22",
    "@types/tar": "^6.1.13",
    "@types/unzipper": "^0.10.10",
    "rimraf": "^6.1.2",
    "typescript": "~4.9.5"
  },
  "scripts": {
    "clean": "rimraf lib-es5",
    "build": "npm run clean && tsc && npm run build:sea-bootstrap",
    "build:sea-bootstrap": "node scripts/build-sea-bootstrap.js",
    "start": "tsc --watch",
    "prepare": "node ./scripts/prepare-or-skip.js",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
